NODE_ENV=development
PORT=3000

# postgres credentials
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# database connection
DB_HOST=
DB_PORT=

# jwt (secrets must be at least 16 characters)
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# bootstrap admin account seeded on first start (password min 8 characters)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
